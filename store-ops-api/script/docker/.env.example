# ============================================================
# store-ops Docker 编排环境变量模板
# 使用: 复制为 .env 后按需修改(真实 .env 已被 .gitignore 忽略,勿提交)
# dev 与 prod 共用本文件; 两套编排的默认值差异写在各自 compose 的 environment 里
# 修改 MYSQL_ROOT_PASSWORD / MINIO_ROOT_PASSWORD 后需删除数据卷重建:
#   dev:  docker compose -p store-ops-dev -f docker-compose.dev.yml down -v
# ============================================================

# ---------- MySQL ----------
# root 密码(业务库 ry-cloud/ry-job/ry-workflow、配置库 ry-config、Seata 库 ry-seata 共用 root)
# 同时供 Nacos 配置库连接使用(经 nacos/override/application.properties 注入)
MYSQL_ROOT_PASSWORD=ruoyi123

# ---------- Redis ----------
# 由 compose 以 --requirepass 命令行参数覆盖 redis.conf 中烘焙的默认密码 ruoyi123
REDIS_PASSWORD=ruoyi123

# ---------- MinIO ----------
# 管理台用户名/密码(密码最小 8 个字符)
MINIO_ROOT_USER=ruoyi
MINIO_ROOT_PASSWORD=ruoyi123

# ---------- Nacos(可选) ----------
# Nacos 控制台与客户端凭据,默认走内置用户 nacos/nacos
# 如需修改: 取消注释并在 Nacos 控制台同步改密(用户数据内置于 ry-config.sql)
#NACOS_USERNAME=nacos
#NACOS_PASSWORD=nacos

# ---------- Seata ----------
# TC 注册到 Nacos 的 IP(客户端从 Nacos 拿到此地址连接 TC,必须客户端可达)
# dev(Windows 宿主跑微服务 + 容器 bridge 网络): 必填宿主机局域网 IP(ipconfig 查看,如 192.168.3.21)
# prod(host 网络): 留空则自动检测本机网卡 IP; 云服务器/多网卡建议显式填写
SEATA_IP=192.168.3.21
