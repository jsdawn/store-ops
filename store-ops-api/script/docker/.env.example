# store-ops 环境凭据模板
# 用法：复制为同目录 .env 并填入真实值（.env 已被 .gitignore 忽略，不入库）
#   cp .env.example .env
# 消费方：
#   - docker-compose.dev.yml / docker-compose.prod.yml（容器编排插值，compose 自动读取本目录 .env）
#   - script/config/nacos/*.yml 的 ${MYSQL_PASSWORD}/${REDIS_PASSWORD} 等占位符（导入 Nacos 后由后端服务运行期解析）
#   - script/config/nacos/import-nacos-config.sh（Nacos 配置导入登录）
#   - 后端服务启动环境（NACOS_PASSWORD/NACOS_USERNAME 等，application.yml 运行期解析）
# 详细说明见 script/docker/README.md

# ============ 通用（dev / prod 共用）============

# MySQL root 密码
MYSQL_PASSWORD=change-me

# Redis 密码（dev）
REDIS_PASSWORD=change-me

# Nacos 管理员账号（控制台登录 + 配置导入脚本 + 后端服务连 Nacos 共用；一般不改）
NACOS_USERNAME=nacos

# Nacos 管理员密码
NACOS_PASSWORD=change-me

# Nacos v3 鉴权 token（Base64；生成：openssl rand -base64 64）
NACOS_TOKEN=change-me-base64

# Nacos 服务端互信身份值（identity value）
NACOS_IDENTITY_VALUE=change-me

# 监控中心凭据（Spring Boot Admin；ruoyi-monitor 服务端与各服务 metadata 共用此值）
MONITOR_PASSWORD=change-me

# RabbitMQ 密码（spring-cloud-bus 消息总线；未部署 MQ 时仅占位）
RABBITMQ_PASSWORD=change-me

# ============ 仅 docker-compose.dev.yml（开发编排）使用 ============

# seata-server 注册地址（dev 专用，机器相关）：后端服务跑在 Windows 宿主，
# TC 若注册容器 bridge IP 宿主不可达，须注册宿主局域网 IP（ipconfig 查 WLAN/以太网的 IPv4），
SEATA_REGISTER_IP=192.168.3.21

# ============ 仅 docker-compose.prod.yml（部署编排）使用 ============

# 后端服务镜像前缀与版本（P6 CI/CD 推 GHCR 后改为 ghcr.io/<github-username>）
RUOYI_IMAGE_PREFIX=ruoyi
RUOYI_IMAGE_TAG=6.0.0

# MinIO 对象存储 root 密码
MINIO_PASSWORD=change-me

# Grafana 监控台管理员密码
GRAFANA_ADMIN_PASSWORD=change-me
