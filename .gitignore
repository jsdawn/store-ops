# IDE（仅根目录级；子项目内部的 IDE 文件由各自 .gitignore 管理）
.idea/
*.iml
*.ipr
*.iws
.vscode/

# 环境变量与密钥（仓库级安全兜底，防止任何位置的凭据误提交）
.env
.env.*
!.env.example
*.pem
application-local.yml

# 日志（仅根目录级；子项目由各自 .gitignore 管理）
logs/
*.log

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# WorkBuddy 项目内部数据（会话/记忆不入库；skills 为项目级共享技能，保留入库）
.workbuddy/*
!.workbuddy/skills/
